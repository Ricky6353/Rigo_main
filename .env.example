# Copy to .env.local for local dev. On Vercel, add the same keys in
# Project → Settings → Environment Variables (Production + Preview), then redeploy.

# Supabase (required for login, shop, uploads, orders)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Publishable key (sb_publishable_... or legacy anon JWT) — safe for browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key
# Secret key (sb_secret_... or legacy service_role JWT) — server only, never NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your_secret_key

# Site URL (SEO, NextAuth callbacks in production)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=generate_a_long_random_string

# Optional: Supabase SQL migrations via API
# SUPABASE_DB_PASSWORD=

# Stripe, Google Sheets, etc. — copy from your existing .env.local as needed
